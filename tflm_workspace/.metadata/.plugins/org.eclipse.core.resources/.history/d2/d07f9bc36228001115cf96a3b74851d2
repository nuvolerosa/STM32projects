const int B = 32;   // batch dimension in your reshape
const int J = 19;   // skeleton joints
const int C = 3;    // (x, ?, y) where x is idx 0 and y is idx 2

// Used by lcd.c (X_increment); value only matters if you call LCD_Output().
extern "C" const float INPUT_RANGE = 1.0f;

static int32_t DequantizeToMilli(int8_t q, int32_t zp, int32_t scale_micro)
{
	const int64_t dq = static_cast<int64_t>(q) - static_cast<int64_t>(zp);
	return static_cast<int32_t>((dq * static_cast<int64_t>(scale_micro)) / 1000LL);
}

