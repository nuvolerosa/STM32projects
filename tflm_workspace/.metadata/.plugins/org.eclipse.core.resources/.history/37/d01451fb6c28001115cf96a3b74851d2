/* Private variables ---------------------------------------------------------*/
// The colors we'll draw
static const uint32_t BACKGROUND_COLOR = LCD_COLOR_YELLOW;
static const uint32_t FOREGROUND_COLOR = LCD_COLOR_RED;

/* Function definitions -----------------------------------------------------*/
/**
  * @brief  LCD and global variables Initialization
  * @param  None
  * @retval None
  */

void LCD_Init(void)
{
	// LCD Initialization
    BSP_LCD_Init();

    // LCD Initialization
    BSP_LCD_LayerDefaultInit(0, LCD_FB_START_ADDRESS);
    BSP_LCD_LayerDefaultInit(1, LCD_FB_START_ADDRESS+(BSP_LCD_GetXSize()*BSP_LCD_GetYSize()*4));

    // Enable the LCD
    BSP_LCD_DisplayOn();

    // Select the LCD Background Layer
    BSP_LCD_SelectLayer(0);

    // Clear the Background Layer
    BSP_LCD_Clear(BACKGROUND_COLOR);

    // Select the LCD Foreground Layer
    // BSP_LCD_SelectLayer(1);

    // Clear the Foreground Layer
    // BSP_LCD_Clear(FOREGROUND_COLOR);

    // Set the foreground color (Setting text color will set the foreground color)
    // BSP_LCD_SetTextColor(FOREGROUND_COLOR);

    // Configure the transparency for foreground and background: Increase the transparency
    BSP_LCD_SetTransparency(0, 0);
    BSP_LCD_SetTransparency(1, 100);

}

/* Skeleton pose: map model x,y to screen with auto bounds (fits any numeric range). */
#define SKEL_DOT_R     5U
#define SKEL_MARGIN    10U

void LCD_DrawSkeletonDots(const float *x, const float *y, int count)
{
    int i;

    if (x == NULL || y == NULL || count <= 0) {
        return;
    }

    float xmin = x[0];
    float xmax = x[0];
    float ymin = y[0];
    float ymax = y[0];

    for (i = 1; i < count; i++) {
        if (x[i] < xmin) {
            xmin = x[i];
        }
        if (x[i] > xmax) {
            xmax = x[i];
        }
        if (y[i] < ymin) {
            ymin = y[i];
        }
        if (y[i] > ymax) {
            ymax = y[i];
        }
    }

    {
        float xspan = xmax - xmin;
        float yspan = ymax - ymin;
        if (xspan < 1e-6f) {
            xspan = 1.f;
        }
        if (yspan < 1e-6f) {
            yspan = 1.f;
        }

        {
            const uint32_t W = BSP_LCD_GetXSize();
            const uint32_t H = BSP_LCD_GetYSize();
            const uint32_t max_x = (W > SKEL_MARGIN * 2U) ? (W - SKEL_MARGIN * 2U) : 1U;
            const uint32_t max_y = (H > SKEL_MARGIN * 2U) ? (H - SKEL_MARGIN * 2U) : 1U;

            BSP_LCD_SelectLayer(1);
            BSP_LCD_Clear(LCD_COLOR_BLACK);
            BSP_LCD_SetTextColor(LCD_COLOR_GREEN);

            for (i = 0; i < count; i++) {
                float nx = (x[i] - xmin) / xspan;
                float ny = (y[i] - ymin) / yspan;
                uint32_t px = SKEL_MARGIN + (uint32_t)(nx * (float)max_x);
                uint32_t py = SKEL_MARGIN + (uint32_t)((1.f - ny) * (float)max_y);
                if (px < SKEL_DOT_R) {
                    px = SKEL_DOT_R;
                }
                if (py < SKEL_DOT_R) {
                    py = SKEL_DOT_R;
                }
                if (px > W - SKEL_DOT_R - 1U) {
                    px = W - SKEL_DOT_R - 1U;
                }
                if (py > H - SKEL_DOT_R - 1U) {
                    py = H - SKEL_DOT_R - 1U;
                }
                BSP_LCD_FillCircle(px, py, SKEL_DOT_R);
            }
        }
    }
}

